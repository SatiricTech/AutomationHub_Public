{
  "SchemaVersion": 1,
  "ClientName": "REPLACE_WITH_CLIENT_NAME",
  "Webhook": {
    "Url": "https://REPLACE-ME.azurewebsites.net/api/servicewatchdog/alert",
    "FunctionKey": "REPLACE_WITH_FUNCTION_KEY",
    "TimeoutSeconds": 30
  },
  "Defaults": {
    "MaxStartAttempts": 5,
    "RetryDelaySeconds": 30,
    "PostStartVerifySeconds": 10,
